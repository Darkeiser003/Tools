{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ltools.dev/schema/ltools-capabilities-v1.json",
  "title": "LTools capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "application", "version", "platform", "entrypoints", "features", "terminal_integration", "actions", "environment", "distribution", "host_tools", "external_integrations", "ui_context"],
  "properties": {
    "schema": { "const": "ltools-capabilities-v1" },
    "application": { "enum": ["LTools", "WTools"] },
    "version": { "type": "string" },
    "platform": { "enum": ["linux", "windows"] },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["menu", "help", "doctor", "cli"],
      "properties": {
        "menu": { "$ref": "#/$defs/entrypoint" },
        "help": { "$ref": "#/$defs/entrypoint" },
        "doctor": { "$ref": "#/$defs/entrypoint" },
        "cli": {
          "allOf": [
            { "$ref": "#/$defs/entrypoint" },
            { "required": ["no_arguments"], "properties": { "no_arguments": { "const": "shows-help" } } }
          ]
        }
      }
    },
    "features": { "type": "array", "items": { "type": "string" } },
    "terminal_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "capability_request", "open_request", "working_directory", "requires_host_terminal", "fallback_allowed"],
      "properties": {
        "schema": { "const": "lterminal-startup-v1" },
        "capability_request": { "type": "array", "items": { "type": "string" } },
        "open_request": { "type": "array", "items": { "type": "string" } },
        "working_directory": { "const": "PATH" },
        "requires_host_terminal": { "const": true },
        "fallback_allowed": { "type": "boolean" }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "legacyId", "actionId", "actionKey", "qualifiedActionKey", "canonicalKey", "scope", "operation", "label", "shortLabel", "displayName", "menuPath", "group", "description", "command", "executable", "args", "aliases", "shell", "workingDirectory", "terminal", "interactive", "requiresAdmin", "confirmation", "safe", "supports", "requiresCommands"],
        "properties": {
          "id": { "type": "string", "pattern": "^(?:linux|windows)\\.[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
          "legacyId": { "type": "string", "minLength": 1 },
          "actionId": { "type": "string", "pattern": "^(?:linux|windows)\\.[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
          "actionKey": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
          "qualifiedActionKey": { "type": "string", "pattern": "^(?:linux|windows)\\.[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
          "canonicalKey": { "type": "string", "pattern": "^(?:linux|windows)\\.[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
          "scope": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "operation": { "type": "string", "pattern": "^[a-z0-9-]+(?:[.][a-z0-9-]+)*$" },
          "label": { "type": "string", "minLength": 1 },
          "shortLabel": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "menuPath": {
            "type": "array",
            "prefixItems": [
              { "type": "string", "minLength": 1 },
              { "type": "string", "minLength": 1 }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "group": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "executable": { "enum": ["ltools", "ltools.exe"] },
          "args": { "type": "array", "items": { "type": "string" } },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "shell": { "const": "none" },
          "workingDirectory": { "enum": ["current", "none"] },
          "terminal": { "const": true },
          "interactive": { "type": "boolean" },
          "requiresAdmin": { "type": "boolean" },
          "confirmation": { "enum": ["none", "before-run", "always"] },
          "safe": { "type": "boolean" },
          "supports": { "type": "array", "items": { "enum": ["dry-run"] }, "uniqueItems": true },
          "requiresCommands": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "safe": { "const": true } } },
            "then": { "properties": { "confirmation": { "const": "none" } } }
          },
          {
            "if": { "properties": { "confirmation": { "const": "none" } } },
            "then": { "properties": { "safe": { "const": true } } }
          }
        ]
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "state_directory", "no_auto_terminal", "cli_profile"],
      "properties": {
        "language": { "const": "LTOOLS_LANG" },
        "state_directory": { "const": "XDG_STATE_HOME/ltools" },
        "no_auto_terminal": { "const": "LTOOLS_NO_AUTO_TERMINAL" },
        "cli_profile": { "const": "LTOOLS_CLI" }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linux", "windows"],
      "properties": {
        "linux": { "$ref": "#/$defs/distribution_entry" },
        "windows": { "$ref": "#/$defs/distribution_entry" }
      }
    },
    "host_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "command", "category", "feature", "required", "installable", "install_package", "available", "version"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "category": { "type": "string" },
          "feature": { "type": "string" },
          "required": { "type": "boolean" },
          "installable": { "type": "boolean" },
          "install_package": { "type": "string" },
          "available": { "type": "boolean" },
          "version": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "external_integrations": {
      "type": "object",
      "required": ["lterminal", "optional", "standalone_releases_require_it"],
      "properties": {
        "lterminal": { "type": "string" },
        "optional": { "type": "boolean" },
        "standalone_releases_require_it": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "ui_context": { "$ref": "#/$defs/ui_context" }
  },
  "$defs": {
    "ui_context": {
      "type": "object",
      "required": ["language", "theme"],
      "properties": {
        "language": {
          "type": "object",
          "required": ["argument", "environment", "values", "fallback"],
          "properties": {
            "argument": { "const": "--lang" },
            "environment": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
            "fallback": { "const": "locale" }
          },
          "additionalProperties": false
        },
        "theme": {
          "type": "object",
          "required": ["argument", "environment", "default", "values", "color_argument", "color_values"],
          "properties": {
            "argument": { "const": "--theme" },
            "environment": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "default": { "const": "ocean" },
            "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
            "color_argument": { "const": "--color" },
            "color_values": { "const": ["auto", "always", "never"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args", "interactive"],
      "properties": {
        "command": { "enum": ["ltools", "ltools-cli", "ltools.exe", "ltools-cli.exe"] },
        "args": { "type": "array", "items": { "type": "string" } },
        "interactive": { "type": "boolean" },
        "no_arguments": { "type": "string" }
      }
    },
    "distribution_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "standalone", "no_arguments", "shell", "updates"],
      "properties": {
        "artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "standalone": { "const": true },
        "no_arguments": { "const": "opens-native-graphical-window" },
        "shell": { "type": "string", "minLength": 1 },
        "updates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["check_args", "download_args", "package_selection", "destination", "automatic_install", "integrity"],
          "properties": {
            "check_args": { "const": ["update", "check"] },
            "download_args": { "const": ["update", "download"] },
            "package_selection": { "type": "string", "minLength": 1 },
            "destination": { "type": "string", "minLength": 1 },
            "automatic_install": { "const": false },
            "integrity": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
