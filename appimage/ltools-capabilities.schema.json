{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ltools.dev/schema/ltools-capabilities-v1.json",
  "title": "LTools capabilities",
  "type": "object",
  "required": ["schema", "application", "version", "platform", "entrypoints", "features", "terminal_integration", "actions", "distribution", "host_tools", "external_integrations", "ui_context"],
  "properties": {
    "schema": { "const": "ltools-capabilities-v1" },
    "application": { "enum": ["LTools", "WinSlim-Tools"] },
    "version": { "type": "string" },
    "platform": { "enum": ["linux", "windows"] },
    "entrypoints": { "type": "object" },
    "features": { "type": "array", "items": { "type": "string" } },
    "terminal_integration": {
      "type": "object",
      "required": ["schema", "capability_request", "open_request", "fallback_allowed"],
      "properties": {
        "schema": { "const": "lterminal-startup-v1" },
        "capability_request": { "type": "array", "items": { "type": "string" } },
        "open_request": { "type": "array", "items": { "type": "string" } },
        "fallback_allowed": { "type": "boolean" }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "group", "command", "executable", "args", "terminal", "interactive", "requiresAdmin", "confirmation", "safe", "supports", "requiresCommands"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "shortLabel": { "type": "string" },
          "group": { "type": "string" },
          "description": { "type": "string" },
          "command": { "type": "string" },
          "executable": { "enum": ["ltools", "ltools.exe"] },
          "args": { "type": "array", "items": { "type": "string" } },
          "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "shell": { "const": "none" },
          "workingDirectory": { "enum": ["current", "none"] },
          "terminal": { "const": true },
          "interactive": { "type": "boolean" },
          "requiresAdmin": { "type": "boolean" },
          "confirmation": { "enum": ["none", "before-run", "always"] },
          "safe": { "type": "boolean" },
          "supports": { "type": "array", "items": { "enum": ["dry-run"] } },
          "requiresCommands": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "distribution": { "type": "object" },
    "host_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "command", "category", "feature", "required", "installable", "install_package", "available", "version"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "category": { "type": "string" },
          "feature": { "type": "string" },
          "required": { "type": "boolean" },
          "installable": { "type": "boolean" },
          "install_package": { "type": "string" },
          "available": { "type": "boolean" },
          "version": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "external_integrations": {
      "type": "object",
      "required": ["lterminal", "optional", "standalone_releases_require_it"],
      "properties": {
        "lterminal": { "type": "string" },
        "optional": { "type": "boolean" },
        "standalone_releases_require_it": { "type": "boolean" }
      }
    },
    "ui_context": { "$ref": "#/$defs/ui_context" }
  },
  "$defs": {
    "ui_context": {
      "type": "object",
      "required": ["language", "theme"],
      "properties": {
        "language": {
          "type": "object",
          "required": ["argument", "environment", "fallback"],
          "properties": {
            "argument": { "const": "--lang" },
            "environment": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "fallback": { "const": "locale" }
          },
          "additionalProperties": false
        },
        "theme": {
          "type": "object",
          "required": ["argument", "environment", "default", "values", "color_argument", "color_values"],
          "properties": {
            "argument": { "const": "--theme" },
            "environment": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "default": { "const": "ocean" },
            "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
            "color_argument": { "const": "--color" },
            "color_values": { "const": ["auto", "always", "never"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
