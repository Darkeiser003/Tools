# LTools — fuentes que sí deben versionarse:
# scripts, Rust/Cargo.lock, documentación, recursos AppImage y tests.

# Artefactos distribuibles y staging local. Todo se puede regenerar con el
# builder; no se guardan releases ni resultados de una máquina concreta.
dist/
build/
out/
artifacts/
release/
**/dist/
**/build/
**/out/
**/artifacts/
.ltools-build.*
.appimage-builder/
*.AppImage
*.appimage
*.tar.gz
*.tar.xz
*.tar.zst
*.zip
SHA256SUMS.txt
SHA256SUMS.txt.sig
*.sig
*.7z
*.deb
*.rpm
*.pkg.tar
*.pkg.tar.*
*.msi
*.dmg

# Rust/Cargo. Cargo.lock se conserva: LTools es una aplicación distribuible.
target/
rust/target/
**/target/
*.rs.bk
*.pdb
*.exe
*.dll
*.lib
*.ilk
*.dSYM/

# Node, JavaScript y gestores de frontend/herramientas auxiliares.
node_modules/
.npm/
.pnpm-store/
.yarn/
.parcel-cache/
.turbo/
.next/
.svelte-kit/
coverage/
**/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python y otras caches de tooling.
__pycache__/
**/__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# Informes, planes, resultados y temporales de pruebas.
reports/
**/reports/
rust-audit-*/
test-results/
.test-results/
.tmp/
tmp/
**/tmp/
*.plan.tsv
*-plan.tsv
migrate-plan.tsv
cleanup-plan.tsv
*.profraw
*.junit.xml
*.tap

# Estado incremental y salidas locales del builder Windows.
windows/.build-state.json
dist/windows/.build-state.json
windows/target/
windows/bin/
windows/obj/

# Logs generados por builds, smoke/E2E y herramientas locales.
*.log
*.log.*
build-*.tsv
*-timings.tsv

# Backups creados por migraciones y editores.
*.bak
*.bak-*
*.old
*~
*.swp
*.swo
*.orig
*.rej

# IDE, sistema operativo y metadatos locales.
.idea/
.vscode/
.fleet/
.DS_Store
Thumbs.db
Desktop.ini

# Caches locales habituales; no afectan a scripts ni a documentación.
.cache/
.local/
.direnv/
.env
.env.*
!.env.example

# Estado local de LTools y herramientas auxiliares.
.ltools/
.ltools-state/
.cargo-local/
