# LTools — fuentes que sí deben versionarse:
# scripts, Rust/Cargo.lock, documentación, recursos AppImage y tests.

# Artefactos distribuibles y staging local. Todo se puede regenerar con el
# builder; no se guardan releases ni resultados de una máquina concreta.
/dist/
/build/
/out/
/artifacts/
/release/
/.ltools-build.*
/.appimage-builder/

# Rust/Cargo. Cargo.lock se conserva: LTools es una aplicación distribuible.
/target/
/rust/target/
*.rs.bk

# Node, JavaScript y gestores de frontend/herramientas auxiliares.
node_modules/
.npm/
.pnpm-store/
.yarn/
.parcel-cache/
.turbo/
.next/
.svelte-kit/
coverage/
**/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python y otras caches de tooling.
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# Informes, planes, resultados y temporales de pruebas.
/reports/
rust-audit-*/
rust-games-*/
rust-package-audit-*/
test-results/
.test-results/
/.tmp/
/tmp/
*.plan.tsv
*-plan.tsv
migrate-plan.tsv
cleanup-plan.tsv
*.profraw
*.junit.xml
*.tap

# Salidas locales del builder Windows.
windows/target/
windows/bin/
windows/obj/

# Backups creados por migraciones y editores.
*.bak
*.bak-*
*.old
*~
*.swp
*.swo
*.orig
*.rej

# IDE, sistema operativo y metadatos locales.
.idea/
.vscode/
.fleet/
.DS_Store
Thumbs.db
Desktop.ini

# Caches locales habituales; no afectan a scripts ni a documentación.
.cache/
.local/
.direnv/
.env
.env.*
!.env.example

# Estado local de LTools y herramientas auxiliares.
.ltools/
.ltools-state/
.cargo-local/

# IA
.agents/
.codex/
