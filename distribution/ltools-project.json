{
  "$schema": "https://ltools.dev/schema/ltools-project-v1.json",
  "schema": "ltools-project-v1",
  "id": "ltools",
  "name": "LTools",
  "description": "Auditoría y mantenimiento multiplataforma para equipos Linux y Windows.",
  "repository": "Darkeiser003/Tools",
  "homepage": "https://github.com/Darkeiser003/Tools",
  "releases": "https://github.com/Darkeiser003/Tools/releases",
  "latest_release_api": "https://api.github.com/repos/Darkeiser003/Tools/releases/latest",
  "release_manifest": "https://github.com/Darkeiser003/Tools/releases/latest/download/ltools-release.json",
  "license": "MIT",
  "integration": {
    "optional": true,
    "descriptor": "ltools-terminal.json",
    "hosts": ["LTerminal", "WinSlim Terminal"],
    "standalone_releases_require_it": false
  },
  "distribution": {
    "source": "github-releases",
    "stable_only": true,
    "manifest": "ltools-release.json",
    "verification": "sha256",
    "update_strategy": "stage-verify-promote",
    "keep_previous": true,
    "allowed_asset_hosts": [
      "github.com",
      "objects.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "github-releases.githubusercontent.com"
    ]
  },
  "platforms": {
    "linux": {
      "artifact_kinds": ["appimage", "appimage-cli", "tarball"],
      "preferred_kind": "appimage",
      "asset_patterns": {
        "appimage": "ltools-{version}-linux-{architecture}.AppImage",
        "appimage-cli": "ltools-{version}-linux-{architecture}-cli.AppImage",
        "tarball": "ltools-{version}-linux-{architecture}.tar.gz"
      },
      "install": {
        "portable": true,
        "recommended_directory": "~/.local/bin",
        "executable": true,
        "entrypoint": "ltools",
        "gui_entrypoint": "ltools",
        "cli_entrypoint": "ltools-cli",
        "update_strategy": "stage-verify-promote"
      }
    },
    "windows": {
      "artifact_kinds": ["exe", "exe-cli", "portable-zip"],
      "preferred_kind": "exe",
      "asset_patterns": {
        "exe": "ltools-{version}-windows-{architecture}.exe",
        "exe-cli": "ltools-{version}-windows-{architecture}-cli.exe",
        "portable-zip": "ltools-{version}-windows-{architecture}.zip"
      },
      "install": {
        "portable": true,
        "recommended_directory": "%LOCALAPPDATA%\\WinSlim-Tools",
        "executable": true,
        "entrypoint": "ltools.exe",
        "gui_entrypoint": "ltools.exe",
        "cli_entrypoint": "ltools-cli.exe",
        "update_strategy": "stage-verify-promote"
      }
    }
  },
  "verification": {
    "hash_algorithm": "sha256",
    "manifest_required": true,
    "signature_supported": true,
    "signature": {
      "algorithm": "ed25519",
      "manifest": "SHA256SUMS.txt",
      "detached_signature": "SHA256SUMS.txt.sig",
      "encoding": "base64"
    }
  }
}
